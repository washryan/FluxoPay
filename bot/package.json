{
  "name": "fluxopay-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "schema:check": "tsx src/schema-check.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && esbuild src/index.ts src/worker.ts src/healthcheck.ts src/schema-check.ts --bundle --platform=node --format=esm --outdir=dist --packages=external"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.43.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
