# Frontend / Next.js
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Use the Supabase Publishable key. Legacy projects can use the anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
# Optional server-only route for SSR/proxy in self-hosted Docker networks.
SUPABASE_INTERNAL_URL="http://supabase-gateway:8000"

# Local app URL used in auth redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to true only before the final self-hosted cutover. Financial Server
# Actions are rejected while authentication and read-only navigation continue.
FLUXOPAY_READ_ONLY="false"

# Optional: public Telegram bot username, without exposing bot token.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username"
